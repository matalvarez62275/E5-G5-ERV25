-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=32;
DEPTH=2048;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
	000  :   0000CAB7;
	[001..00A]  :   00128293;
	00B  :   000AB2B7;
	[00C..00D]  :   00000013;
	[00E..7FF]  :   00000000;
END;
