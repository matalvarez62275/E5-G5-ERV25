-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=32;
DEPTH=8192;

ADDRESS_RADIX=UNS;
DATA_RADIX=HEX;
CONTENT BEGIN
    0 : 0000007F;
    1 : FFFFFFC0;
    2 : 00000020;
    3 : FFFFFFF0;
    4 : 00000008;
    5 : FFFFFFFC;
    6 : 00000002;
    7 : FFFFFFFF;
END;